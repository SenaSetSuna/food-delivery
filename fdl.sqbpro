ALTER TABLE &quot;Transaction&quot; ADD COLUMN handled_by TEXT;
ALTER TABLE &quot;Transaction&quot; ADD COLUMN amount_tendered REAL DEFAULT 0;
ALTER TABLE &quot;Transaction&quot; ADD COLUMN change_amount REAL DEFAULT 0;
ALTER TABLE &quot;Transaction&quot; ADD COLUMN transaction_type TEXT DEFAULT 'offline';

-- Create a new table for Cashier Shifts
CREATE TABLE kasir_shifts (
    id_shift INTEGER PRIMARY KEY AUTOINCREMENT,
    kasir_name TEXT NOT NULL,
    start_time DATETIME DEFAULT CURRENT_TIMESTAMP,
    end_time DATETIME,
    starting_cash REAL NOT NULL DEFAULT 0,
    ending_cash REAL,
    status TEXT DEFAULT 'open'
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
